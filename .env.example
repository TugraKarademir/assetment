# .env.example — bu dosyayı .env olarak kopyalayıp doldurun. .env ASLA sürüm kontrolüne eklenmez.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OpenAI uyumlu yerel uç nokta (Ollama: http://localhost:11434/v1, vLLM: http://localhost:8000/v1)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
# Eşleme tablosu şifreleme anahtarı: `uv run scoring gen-key`
MAPPING_KEY=
